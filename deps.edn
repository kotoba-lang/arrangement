{:paths ["src"]
 ;; The query layer is NOT here. It lives in `kotoba-lang/datalog`
 ;; (`datalog.index` / `datalog.query` / `datalog.core`) and this repo
 ;; consumes it. `arrangement.query` and `arrangement.datalog` are
 ;; compatibility shims that re-export from it, and `arrangement.core`
 ;; re-exports the four covering indexes with its own `ipld/link?` default
 ;; for `ref?`. Keeping a second copy here is what cost a full re-extraction
 ;; once already: arrangement kept developing and the extracted library went
 ;; silently 20 commits stale. There is now exactly one copy, so drift is not
 ;; something to notice -- it is something that cannot happen.
 ;; `datalog` pulls in only `datom-source`, which is already pinned below to
 ;; the same SHA, so this adds no new transitive dependency.
 :deps {io.github.kotoba-lang/prolly-tree {:git/sha "644753aec57e12c9588786d46751b1503a5fd6f0"}
        io.github.kotoba-lang/io-ipld {:git/sha "f99bf27d58a75bb8cf6ddfd2d57a0aaac9c824ac"}
        io.github.kotoba-lang/datom-source {:git/sha "3a99b1b1fb2d2f8736995076eb1ab5f94f0808b7"}
        io.github.kotoba-lang/datalog {:git/sha "a43dc1cf72ce6abd8969e206c3b1efe89bb0500c"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Writer-contention benchmark (single-lane CAS vs partitioned root).
  ;;   clojure -M:bench [writers] [writes-per-writer]
  :bench {:extra-paths ["test"]
          :extra-deps {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
          :main-opts ["-m" "arrangement.writer-contention-bench"]}
  ;; Read-scaling benchmark (cost of merge-on-read vs partition count).
  ;;   clojure -M:read-bench [total-facts] [queries] [k...]
  ;; Composed cache stack (block-cache + datom-source/cached).
  ;;   clojure -M:cache-bench
  :cache-bench {:extra-paths ["test"]
                :extra-deps {io.github.kotoba-lang/block-cache
                             {:git/sha "461f9c472480b49f09c5665fc9ee244e7def121e"}
                             io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                :main-opts ["-m" "arrangement.cache-stack-bench"]}
  :read-bench {:extra-paths ["test"]
               :extra-deps {io.github.cognitect-labs/test-runner
                            {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
               :main-opts ["-m" "arrangement.read-scaling-bench"]}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
